# This port targets Windows, but its harness is POSIX bash run under Git
# Bash / MSYS2 (and, for the glibc oracle, inside a WSL2 guest). Shell
# scripts and C sources must therefore keep LF endings even in a Windows
# checkout, or /usr/bin/env cannot resolve the interpreter in a shebang
# line.
* text=auto eol=lf
*.sh text eol=lf
*.c  text eol=lf
*.rs text eol=lf
*.md text eol=lf
*.toml text eol=lf
